digraph MVC {
 graph [rankdir=LR,bgcolor="white",pad=".2",ranksep=".6",nodesep=".5",fontname="DejaVu Sans"];
 node [shape=box,style="rounded,filled",fillcolor="#f1edff",color="#6c38dc",fontname="DejaVu Sans",fontsize=12,margin=".15,.14"];
 navegador [label="Navegador\nHTML · CSS · JavaScript · Bootstrap",fillcolor="#e7f3ff",color="#2f77a8"];
 router [label="index.php\nEnrutamiento y control de acceso"];
 controllers [label="Controladores PHP POO\nAuthController\nDisenadorController\nAdminController"];
 models [label="Modelos PDO\nUsuarioModel · DisenoModel · AdminModel"];
 vistas [label="Vistas\nLogin · Diseñador · Mis diseños\nAdministrador · Reportes"];
 mysql [label="MySQL\nTablas relacionales",fillcolor="#e7faef",color="#21865e"];
 navegador -> router [label="solicitud HTTP"];
 router -> controllers;
 controllers -> models [label="consultar/guardar"];
 models -> mysql [label="SQL preparado"];
 controllers -> vistas [label="datos"];
 vistas -> navegador [label="respuesta HTML"];
}
