digraph ER {
 graph [rankdir=LR, bgcolor="white", splines=polyline, pad="0.18", nodesep="0.42", ranksep="0.9"];
 node [shape=record, fontname="DejaVu Sans", fontsize=10, style="rounded,filled", fillcolor="#f1edff", color="#7249bd", fontcolor="#1e2033"];
 edge [fontname="DejaVu Sans", fontsize=9, color="#54627e", arrowsize=.7];
 rol [label="{ROLES|PK id\lnombre\l}"];
 usuario [label="{USUARIOS|PK id\lFK rol_id\lnombre\lcorreo\lpassword_hash\lestado\lcreado_en\l}"];
 categoria [label="{CATEGORIAS|PK id\lnombre\ldescripcion\lestado\l}"];
 prenda [label="{PRENDAS|PK id\lFK categoria_id\lnombre\ldescripcion\limagen\lestado\l}"];
 diseno [label="{DISENOS|PK id\lFK usuario_id\lFK prenda_id (opcional)\lnombre\ltalla, color, tela\lescote, manga, largo\limagen_referencia\l}"];
 solicitud [label="{SOLICITUDES|PK id\lFK usuario_id\lFK diseno_id\ldescripcion\lestado\lfechas\l}"];
 detalle [label="{DETALLES_SOLICITUD|PK id\lFK solicitud_id\lFK prenda_id (opcional)\lcantidad\lespecificaciones JSON\l}"];
 cfg [label="{CONFIGURACION|PK clave\lvalor\l}",fillcolor="#e6f6ff",color="#246f9c"];
 rol -> usuario [label="1:N"];
 categoria -> prenda [label="1:N"];
 usuario -> diseno [label="1:N"];
 usuario -> solicitud [label="1:N"];
 prenda -> diseno [label="1:N"];
 diseno -> solicitud [label="1:N"];
 solicitud -> detalle [label="1:N"];
 prenda -> detalle [label="1:N"];
}
